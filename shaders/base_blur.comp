#version 450

// Half-res base layer (tight weighted 3x3 lowpass; reduces Laplacian edge halos)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uInput;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D uBase;
layout(std140, set = 0, binding = 2) uniform BlurParams {
    uvec2 fullExtent;
    uvec2 halfExtent;
    float inputIsSrgb;
    float _pad0;
    float _pad1;
    float _pad2;
};

float srgbToLinear(float c)
{
    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}

vec3 srgbToLinear(vec3 c)
{
    return vec3(srgbToLinear(c.r), srgbToLinear(c.g), srgbToLinear(c.b));
}

void main()
{
    const uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= halfExtent.x || gid.y >= halfExtent.y) {
        return;
    }

    // Center in full-res UV
    vec2 center = (vec2(gid) * 2.0 + vec2(1.0)) / vec2(fullExtent);
    vec2 texel = 1.0 / vec2(fullExtent);

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 uv = center + vec2(float(x), float(y)) * texel * 2.0;
            uv = clamp(uv, texel, vec2(1.0) - texel);
            vec3 rgb = texture(uInput, uv).rgb;
            if (inputIsSrgb > 0.5) {
                rgb = srgbToLinear(rgb);
            }
            // Center-heavy weights: 4 center, 2 edge, 1 corner
            float w = 4.0 - float(abs(x) + abs(y));
            sum += rgb * w;
            wsum += w;
        }
    }
    imageStore(uBase, ivec2(gid), vec4(sum / max(wsum, 1e-3), 1.0));
}
