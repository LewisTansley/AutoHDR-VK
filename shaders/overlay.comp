#version 450

// In-swapchain calibrator HUD: intensity + shape + color sliders.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform OverlayParams {
    uvec2 extent;
    float intensity;
    float colorIntensity;
    float expansionShape;
    float focused;    // 0 = intensity, 1 = shape, 2 = color
    float outputMode; // 0=pq, 1=scrgb, 2=sdr
    float panelNits;
    float pointerValid;
    float pointerX;
    float pointerY;
    float _pad0;
    float _pad1;
};

layout(set = 0, binding = 1, rgba16f) uniform image2D uImage;

vec3 linearToPq(vec3 x)
{
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    vec3 y = pow(max(x, vec3(0.0)) / 10000.0, vec3(m1));
    vec3 nd = (c1 + c2 * y) / (1.0 + c3 * y);
    return pow(nd, vec3(m2));
}

vec3 encodeHud(vec3 linearRgb01, float nits)
{
    vec3 nitsRgb = linearRgb01 * nits;
    if (outputMode < 0.5) {
        return linearToPq(nitsRgb);
    }
    if (outputMode < 1.5) {
        return nitsRgb / 80.0;
    }
    return linearRgb01;
}

uint digitBits(int d)
{
    const uint patterns[10] = uint[](
        0x7B6Fu, // 0
        0x2492u, // 1
        0x73E7u, // 2
        0x79E7u, // 3
        0x5BE4u, // 4
        0x79EFu, // 5
        0x7BEFu, // 6
        0x4927u, // 7
        0x7BE7u, // 8
        0x79E7u  // 9
    );
    return patterns[clamp(d, 0, 9)];
}

bool digitPixel(int d, int px, int py)
{
    if (px < 0 || px >= 3 || py < 0 || py >= 5) {
        return false;
    }
    uint bits = digitBits(d);
    uint bit = uint(py * 3 + px);
    return ((bits >> bit) & 1u) != 0u;
}

bool drawValue(vec2 p, vec2 origin, float value)
{
    int hundredths = int(round(clamp(value, 0.0, 1.0) * 100.0));
    int d0 = hundredths / 100;
    int d1 = (hundredths / 10) % 10;
    int d2 = hundredths % 10;
    ivec2 ip = ivec2(floor(p - origin));
    if (ip.y < 0 || ip.y >= 10) {
        return false;
    }
    // "0.xx" layout: digit, dot, digit, digit — scaled 2x
    int cell = ip.x / 8;
    int lx = (ip.x % 8) / 2;
    int ly = ip.y / 2;
    if (cell == 0) {
        return digitPixel(d0, lx, ly);
    }
    if (cell == 1) {
        return (lx == 1 && ly == 4);
    }
    if (cell == 2) {
        return digitPixel(d1, lx, ly);
    }
    if (cell == 3) {
        return digitPixel(d2, lx, ly);
    }
    return false;
}

// Letter ids: A C E H I L N O P R S T Y
uint letterBits(int id)
{
    const uint patterns[13] = uint[](
        0x5BEAu, // A
        0x724Fu, // C
        0x73CFu, // E
        0x5BE5u, // H
        0x748Fu, // I
        0x7241u, // L
        0x5B59u, // N
        0x7B6Fu, // O
        0x13EFu, // P
        0x57EFu, // R
        0x79EFu, // S
        0x2477u, // T
        0x26ADu  // Y
    );
    return patterns[clamp(id, 0, 12)];
}

bool letterPixel(int id, int px, int py)
{
    if (px < 0 || px >= 3 || py < 0 || py >= 5) {
        return false;
    }
    uint bits = letterBits(id);
    uint bit = uint(py * 3 + px);
    return ((bits >> bit) & 1u) != 0u;
}

int labelLetter(int row, int cell)
{
    // INTENSITY
    const int intensityLetters[9] = int[](4, 6, 11, 2, 6, 10, 4, 11, 12);
    // SHAPE
    const int shapeLetters[5] = int[](10, 3, 0, 8, 2);
    // COLOR
    const int colorLetters[5] = int[](1, 7, 5, 7, 9);

    if (row == 0) {
        if (cell < 0 || cell >= 9) {
            return -1;
        }
        return intensityLetters[cell];
    }
    if (row == 1) {
        if (cell < 0 || cell >= 5) {
            return -1;
        }
        return shapeLetters[cell];
    }
    if (cell < 0 || cell >= 5) {
        return -1;
    }
    return colorLetters[cell];
}

bool drawLabel(vec2 p, vec2 origin, int row)
{
    ivec2 ip = ivec2(floor(p - origin));
    if (ip.y < 0 || ip.y >= 10 || ip.x < 0) {
        return false;
    }
    int cell = ip.x / 8;
    int id = labelLetter(row, cell);
    if (id < 0) {
        return false;
    }
    int lx = (ip.x % 8) / 2;
    int ly = ip.y / 2;
    // 1px gap between glyphs (lx == 3 unused)
    if (lx >= 3) {
        return false;
    }
    return letterPixel(id, lx, ly);
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= extent.x || gid.y >= extent.y) {
        return;
    }

    float w = float(extent.x);
    float h = float(extent.y);
    float pw = min(520.0, w * 0.55);
    float ph = 148.0;
    float x0 = (w - pw) * 0.5;
    float y0 = h - ph - 48.0;
    float x1 = x0 + pw;
    float y1 = y0 + ph;

    vec2 p = vec2(gid);
    float nits = max(panelNits, 80.0);
    bool wrote = false;
    vec3 outRgb = vec3(0.0);

    const bool inPanel = (p.x >= x0 && p.x <= x1 && p.y >= y0 && p.y <= y1);
    if (inPanel) {
        vec4 cur = imageLoad(uImage, ivec2(gid));
        vec3 bg = encodeHud(vec3(0.08, 0.09, 0.12), nits * 0.35);
        outRgb = mix(cur.rgb, bg, 0.78);

        float trackX0 = x0 + 140.0;
        float trackX1 = x0 + pw - 70.0;
        float trackH = 14.0;
        // Row order: Intensity, Shape, Color
        float intensityY = y0 + 34.0;
        float shapeY = y0 + 68.0;
        float colorY = y0 + 102.0;

        if (p.y < y0 + 22.0) {
            outRgb = mix(outRgb, encodeHud(vec3(0.15, 0.35, 0.55), nits * 0.55), 0.85);
        }

        float b = 2.0;
        if (p.x <= x0 + b || p.x >= x1 - b || p.y <= y0 + b || p.y >= y1 - b) {
            outRgb = encodeHud(vec3(0.9, 0.7, 0.2), nits);
        }

        for (int row = 0; row < 3; ++row) {
            float trackY = (row == 0) ? intensityY : ((row == 1) ? shapeY : colorY);
            float value = (row == 0) ? intensity : ((row == 1) ? expansionShape : colorIntensity);
            bool focus = abs(focused - float(row)) < 0.5;

            if (p.x >= x0 + 12.0 && p.x <= x0 + 126.0 && p.y >= trackY - 2.0 && p.y <= trackY + trackH + 2.0) {
                vec3 lab = focus ? vec3(0.95, 0.85, 0.35) : vec3(0.75, 0.78, 0.82);
                outRgb = mix(outRgb, encodeHud(lab, nits * 0.7), 0.55);
            }

            if (drawLabel(p, vec2(x0 + 16.0, trackY - 1.0), row)) {
                outRgb = encodeHud(vec3(0.08, 0.08, 0.10), nits);
            }

            if (p.x >= trackX0 && p.x <= trackX1 && p.y >= trackY && p.y <= trackY + trackH) {
                float t = clamp(value, 0.0, 1.0);
                float fillX = mix(trackX0, trackX1, t);
                vec3 trackBg = vec3(0.18, 0.20, 0.24);
                vec3 fill = focus ? vec3(0.95, 0.75, 0.20) : vec3(0.35, 0.70, 0.95);
                vec3 col = (p.x <= fillX) ? fill : trackBg;
                outRgb = encodeHud(col, nits * 0.85);
            }

            if (drawValue(p, vec2(trackX1 + 10.0, trackY - 1.0), value)) {
                outRgb = encodeHud(vec3(0.95, 0.95, 0.98), nits);
            }
        }
        wrote = true;
    }

    if (pointerValid > 0.5) {
        vec2 d = abs(p - vec2(pointerX, pointerY));
        bool cross = (d.x <= 1.5 && d.y <= 10.0) || (d.y <= 1.5 && d.x <= 10.0);
        bool tip = max(d.x, d.y) <= 2.5;
        if (cross || tip) {
            if (!wrote) {
                outRgb = imageLoad(uImage, ivec2(gid)).rgb;
            }
            outRgb = encodeHud(vec3(1.0, 0.95, 0.2), nits);
            wrote = true;
        }
    }

    if (wrote) {
        imageStore(uImage, ivec2(gid), vec4(outRgb, 1.0));
    }
}
