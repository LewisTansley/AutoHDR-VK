#version 450
#extension GL_GOOGLE_include_directive : require

// Resolve fp16 compute output into A2B10G10R10 / A2R10G10B10 swap-format storage.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uInput;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D uOutput;

layout(std140, set = 0, binding = 2) uniform PresentParams {
    uvec2 extent;
    uint rgb10PackMode; // 0 = A2B10G10R10, 1 = A2R10G10B10
    uint unormBgra;
    uint outputBits;
    uint outputMode; // 0=pq, 1=scrgb, 2=sdr
    float ditherStrength;
    float useBlueNoise;
    float _pad0;
    float _pad1;
    float _pad2;
    float _pad3;
};

#include "dither.glsl"

uint packA2B10G10R10(vec4 c)
{
    uvec4 u = uvec4(round(clamp(c, 0.0, 1.0) * vec4(1023.0, 1023.0, 1023.0, 3.0)));
    return u.r | (u.g << 10u) | (u.b << 20u) | (u.a << 30u);
}

uint packA2R10G10B10(vec4 c)
{
    uvec4 u = uvec4(round(clamp(c, 0.0, 1.0) * vec4(1023.0, 1023.0, 1023.0, 3.0)));
    return u.b | (u.g << 10u) | (u.r << 20u) | (u.a << 30u);
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= extent.x || gid.y >= extent.y) {
        return;
    }

    vec2 uv = (vec2(gid) + vec2(0.5)) / vec2(extent);
    vec3 rgb = texture(uInput, uv).rgb;
    rgb = applyPresentDither(rgb, gid, ditherStrength, outputBits, outputMode, useBlueNoise);
    vec4 c = vec4(rgb, 1.0);
    uint packed = rgb10PackMode > 0u ? packA2R10G10B10(c) : packA2B10G10R10(c);
    imageStore(uOutput, ivec2(gid), uvec4(packed, 0u, 0u, 0u));
}
