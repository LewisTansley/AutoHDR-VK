#version 450

// Single workgroup reduce: geo-mean, p05 (p10 slot), p25 (k1 slot), p90, near-max white (p98), GPU EMA.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer GlobalHistogram {
    uint bins[]; // 64
};

layout(std430, set = 0, binding = 1) buffer SceneStatsRW {
    float geoMean;
    float p10; // p05 content-floor candidate for raised-floor detect
    float p90;
    float p98; // near-max content white (top bin with sufficient mass)
    float k1;  // p25 bulk shadow for flatness detect
    float effectivePeak;
    float maxCLL;
    float maxFALL;
    uint initialized;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

layout(std140, set = 0, binding = 2) uniform AdaptParams {
    float intensity;
    float referenceNits;
    float peakNits;
    float sdrWhiteNits;
    float adaptBrighten; // e.g. 0.25
    float adaptDarken;   // e.g. 0.05
    float temporalEnable;
    float _pad;
};

shared uint binLocal[64];
shared uint totalPixels;

float ema(float prev, float target, bool goingUp)
{
    float a = goingUp ? adaptBrighten : adaptDarken;
    return mix(prev, target, clamp(a, 0.0, 1.0));
}

void main()
{
    const uint id = gl_LocalInvocationIndex;
    binLocal[id] = bins[id];
    barrier();

    if (id == 0u) {
        uint sum = 0u;
        for (uint i = 0u; i < 64u; ++i) {
            sum += binLocal[i];
        }
        totalPixels = max(sum, 1u);

        float logSum = 0.0;
        uint count = 0u;
        for (uint i = 0u; i < 64u; ++i) {
            uint c = binLocal[i];
            if (c == 0u) {
                continue;
            }
            float u = (float(i) + 0.5) / 64.0;
            float logY = u * 10.0 - 10.0;
            logSum += logY * float(c);
            count += c;
        }
        float meanLog = logSum / float(max(count, 1u));
        float geo = exp2(meanLog);

        uint target05 = max(totalPixels / 20u, 1u);
        uint target25 = max(totalPixels / 4u, 1u);
        uint target90 = (totalPixels * 9u) / 10u;
        uint cum = 0u;
        float p05v = geo;
        float p25v = geo;
        float p90v = geo;
        bool got05 = false;
        bool got25 = false;
        bool got90 = false;
        for (uint i = 0u; i < 64u; ++i) {
            cum += binLocal[i];
            float u = (float(i) + 0.5) / 64.0;
            float y = exp2(u * 10.0 - 10.0);
            if (!got05 && cum >= target05) {
                p05v = y;
                got05 = true;
            }
            if (!got25 && cum >= target25) {
                p25v = y;
                got25 = true;
            }
            if (!got90 && cum >= target90) {
                p90v = y;
                got90 = true;
                break;
            }
        }

        // Near-max content white: highest bin with enough mass (~top 0.0125%),
        // so sparse doorway/speculars define white instead of wall mass.
        uint minMass = max(totalPixels / 8000u, 1u);
        float yMaxv = p90v;
        for (int i = 63; i >= 0; --i) {
            if (binLocal[i] >= minMass) {
                float u = (float(i) + 0.5) / 64.0;
                yMaxv = exp2(u * 10.0 - 10.0);
                break;
            }
        }
        // If the mass bar still missed sparse tops, accept any occupied bin above p90.
        if (yMaxv <= p90v + 1e-6) {
            for (int i = 63; i >= 0; --i) {
                if (binLocal[i] >= 1u) {
                    float u = (float(i) + 0.5) / 64.0;
                    float y = exp2(u * 10.0 - 10.0);
                    if (y > yMaxv) {
                        yMaxv = y;
                    }
                    break;
                }
            }
        }
        yMaxv = max(yMaxv, p90v);

        // User-configured peak; intensity is applied only as post-map mix in tonemap.
        float maxEffectPeak = max(peakNits, max(referenceNits, sdrWhiteNits));
        float peakRaw = maxEffectPeak;

        float geoOut = geo;
        float p05Out = p05v;
        float p25Out = p25v;
        float p90Out = p90v;
        float yMaxOut = yMaxv;
        float peakOut = peakRaw;
        if (temporalEnable > 0.5 && initialized != 0u) {
            geoOut = ema(geoMean, geo, geo > geoMean);
            p05Out = ema(p10, p05v, p05v > p10);
            p25Out = ema(k1, p25v, p25v > k1);
            p90Out = ema(p90, p90v, p90v > p90);
            yMaxOut = ema(p98, yMaxv, yMaxv > p98);
        }

        geoMean = geoOut;
        p10 = p05Out;
        p90 = p90Out;
        p98 = yMaxOut;
        k1 = p25Out;
        effectivePeak = peakOut;
        maxFALL = geoOut * referenceNits;
        maxCLL = yMaxOut * peakOut;
        initialized = 1u;
    }
}
